      "outline_excerpts": [
        "\u5c0f\u7ec4\u6210\u5458\uff1a\u674e\u5ef6\u987a\u3001\u97e9\u4f73\u8fb0\u3001\u738b\u9053\u73ba\u3001\u738b\u6cd5\u694a\u3001\u5b59\u91d1\u826f\u3001\u8d75\u539f\u767b",
        "\u65b9\u6cd5\u4e00\uff1a\u66f4\u6539\u6539\u53d8\u7535\u8def\u4e2d\u7535\u963b\u963b\u503c\uff0cR1\u6539\u4e3a100\u03a9\uff0cR2\u6539\u4e3a200k\u03a9",
        "\u65b9\u6cd5\u4e8c\uff1a\u66f4\u6539\u7535\u6e90\u7535\u538b\uff1a\u5c06\u7535\u538b\u4ece1V\u66f4\u6539\u52305V",
        "\u65b9\u6cd5\u4e09\uff1a\u540c\u65f6\u66f4\u6539\u7535\u963b\u503c\u548c\u7535\u538b\u503c\uff1a\u5c06\u4e24\u7535\u963b\u503c\u6539\u4e3a10k\uff0c\u7535\u538b\u4ece1V\u66f4\u6539\u52305V",
        "\u65b9\u6cd5\u56db\uff1a\u5c06\u4e8c\u6781\u7ba1\u4e2d\u7684Si\u6750\u6599\u6362\u4e3aGe\u6750\u6599",
        "\u9644\uff1a\u66f4\u6362\u6750\u6599\u540e\u7684I-V\u66f2\u7ebf",
        "(\u5c1d\u8bd5\u589e\u52a00.6V\u76f4\u6d41\u7535\u538b\u53d1\u73b0\u6bd4\u4ea4\u6d41\u7535\u6e90\u66f2\u7ebf\u66f4\u9ad8..)"
      ]
    },
    {
      "relative_path": "\u7814\u7a76\u65b9\u6cd5\u4ee5\u53ca\u7ed3\u679c(1).docx",
      "format": "docx",
      "paragraph_count": 7,
      "table_count": 0,
      "media_count": 0,
      "outline_excerpts": [
        "\u7814\u7a76\u65b9\u6cd5\uff1a",
        "\u9996\u5148\u63d0\u51fa\u95ee\u9898\uff1a\u975e\u6676In-Ga-Zn-O (a-IGZO)\u5bf9\u5927\u6c14\u7684\u6c27\u548c\u6c22\u654f\u611f\uff0c\u9700\u660e\u786e\u6c27\u548c\u6c22\u5728\u975e\u6676In-Ga-Zn-O\u7684\u4f5c\u7528\u3002",
        "\u7136\u540e\u5206\u7c7b\u8ba8\u8bba\uff1a\u5bf9\u4e8e\u4e24\u79cd\u4e0d\u540c\u7684\u5f71\u54cd\u56e0\u7d20\u201c\u6c27\u201d\u548c\u201c\u6c22\u201d\uff0c\u5206\u522b\u5efa\u7acb\u4e0d\u540c\u7684\u6a21\u578b\u6765\u8ba1\u7b97\u3002",
        "\u4f7f\u7528\u4e0d\u540c\u65b9\u6cd5\u89e3\u51b3\u4e0d\u540c\u95ee\u9898\uff1a\u4f7f\u7528\u7b2c\u4e00\u6027\u539f\u7406\u5bc6\u5ea6\u6cdb\u51fd\u7406\u8bba(DFT)\u8ba1\u7b97a-IGZO\u7684\u539f\u5b50\u548c\u7535\u5b50\u7ed3\u6784\u3001\u7f3a\u9677\u5f62\u6210\u80fd\u548c\u952e\u80fd\u3002\u91c7\u7528\u7ecf\u5178\u5206\u5b50\u52a8\u529b\u5b66(MD)\u6a21\u62df\u65b9\u6cd5\uff0c\u5efa\u7acb\u4e86a-IGZO\u7684\u521d\u59cb\u6a21\u578b\u3002\u7528\u5e73\u5747\u952e\u957f\u6c42\u5f97\u5e73\u5747\u952e\u80fd\uff0c\u5b9a\u91cf\u5730\u8bc1\u660e\u4e86Ga-O\u952e\u662fa-IGZO\u7ec4\u6210\u5316\u5b66\u952e\u4e2d\u6700\u5f3a\u7684\u952e\u3002\u901a\u8fc7\u5bf9\u6bd4a-IGZO\u7684\u7535\u5b50\u7ed3\u6784:H\u6a21\u578b\uff0c\u5f97\u51fa\u6c27\u548c\u6c22\u7684\u4f5c\u7528\u3002",
