    {
      "relative_path": "\u5c0f\u7ec4\uff1a\u674e\u5ef6\u987a\u3001\u97e9\u4f73\u8fb0\u3001\u738b\u9053\u73ba\u3001\u738b\u6cd5\u694a\u3001\u5b59\u91d1\u826f\u3001\u8d75\u539f\u767b.docx",
      "format": "docx",
      "paragraph_count": 7,
