  "conflicts": [
    {
      "conflict_id": "C01",
      "subject": "Al2O3 thickness definitions",
      "record_a": "30 nm physical process dielectric",
      "record_b": "10 nm SPICE effective TOX",
      "resolution": "Keep separate fields; never substitute one for the other.",
      "impact": "Use 30 nm in physical TCAD geometry and 10 nm only in the compact-model effective-TOX context.",
      "status": "resolved_by_scope"
    },
    {
      "conflict_id": "C02",
      "subject": "IGZO parameter sets",
      "record_a": "Course teaching values: mobility about 35.5 cm2/(V*s), VTH 0.21 V",
      "record_b": "Older paper values: mobility 10.05 cm2/(V*s), VTH 5.00 V",
      "resolution": "Do not merge the two batches or use the older values in the active teaching baseline.",
      "impact": "No cross-batch calibration claim.",
      "status": "resolved_by_dataset_separation"
    },
    {
      "conflict_id": "C03",
      "subject": "Top-gate physical scope",
      "record_a": "Fabricated baseline lists a bottom gate and 30 nm Al2O3",
      "record_b": "T00 uses a symmetric top-gate teaching extension",
      "resolution": "Keep T00 as a research electrostatic extension, not as the stated fabricated baseline.",
      "impact": "T01 starts with an explicitly single-gate geometry.",
      "status": "resolved_by_scope"
    },
    {
      "conflict_id": "C04",
      "subject": "Primary I-V availability",
      "record_a": "Teacher raw Id-Vg/Id-Vd, batch, and full conditions are unavailable",
      "record_b": "Existing behavioral and senior curves have incomplete provenance or metadata",
      "resolution": "Use only a teaching baseline for T01 and prohibit quantitative experimental fitting.",
      "impact": "G0 permits E2 teaching simulation but blocks E3+ calibration claims.",
      "status": "open_external_input"
    },
    {
      "conflict_id": "C05",
      "subject": "Senior reference data metadata",
      "record_a": "Senior IGZO transfer XLSX",
      "record_b": "Senior inverter VTC XLSX",
      "resolution": "Retain source rows and quality flags; both stay reference_only until conditions are recovered.",
      "impact": "No fitting, no circuit validation, and no renamed operating conditions.",
      "status": "open_external_input"
    },
    {
      "conflict_id": "C06",
      "subject": "Historical SnO assets",
      "record_a": "Older external simulation folders contain SnO and complementary-logic files",
      "record_b": "Current project scope is n-type IGZO only",
      "resolution": "Only the IGZO whitelist is imported into data/raw/baseline; historical SnO references remain excluded.",
      "impact": "No SnO device, model, netlist, or layout may enter active implementation.",
      "status": "resolved_by_scope"
    }
  ],
