    ],
    "execution_order": [
      "create one fresh T02-A enabled-top-stack device for each fixed bottom-gate voltage",
      "solve all-zero-bias Poisson initialization and coupled electron equilibrium",
      "repeat the T02-C low-VDS ladder with both gates at 0 V",
      "ramp the bottom secondary gate from 0 V to its target in 0.1 V increments",
      "precondition the top primary gate from 0 V down to -0.5 V",
      "sweep the exact 31-point top-gate grid upward from -0.5 V to 1.0 V",
      "save the VTG=0.3 V state for that fixed bottom-gate voltage",
      "delete the device before creating the next fixed bottom-gate voltage"
    ]
  },
  "extraction_methods": {
    "constant_current_vth_proxy": {
      "name": "constant_current_log_interpolation",
      "criterion_formula": "10 nA * (W/L) terminal current",
      "criterion_prefactor_a": 1e-8,
      "expected_terminal_current_a": 6e-8,
      "expected_current_per_width_a_per_cm": 1e-5,
      "interpolation": "linear primary-gate-voltage interpolation in log10(abs(drain current per unit width))"
    },
    "delta_vth_proxy": {
      "name": "fixed-secondary constant-current threshold shift",
      "reference_secondary_gate_v": 0.0,
      "definition": "VTH(fixed secondary gate) minus VTH(fixed secondary gate = 0 V) within one primary-gate orientation"
    },
    "gm_proxy": {
      "name": "central_difference_then_linear_interpolation",
      "evaluation_overdrive_v": 0.2,
      "definition": "central-difference derivative of abs(drain current) versus primary-gate voltage, linearly interpolated at VTH + 0.2 V",
      "reported_units": ["S/cm", "S terminal"]
    },
    "coupling_slope_proxy": {
      "name": "ordinary_least_squares_delta_vth_vs_secondary_bias",
      "definition": "five-point OLS slope of constant-current VTH versus fixed bottom-gate voltage",
      "reported_unit": "V/V"
    }
