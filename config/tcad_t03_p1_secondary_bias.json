      {"state_id": "p1_vbg_m0p2_common_primary", "label": "P1 VBG=-0.2 V common-primary proxy", "source_family": "top_primary", "vbg_v": -0.2, "vtg_v": 0.3},
      {"state_id": "p1_vbg_0p0_common_primary", "label": "P1 VBG=0 V common-primary proxy", "source_family": "top_primary", "vbg_v": 0.0, "vtg_v": 0.3},
