    "minimum_absolute_coupling_slope_v_per_v": 0.5,
    "maximum_absolute_coupling_slope_v_per_v": 1.5,
    "minimum_coupling_fit_r_squared": 0.99,
    "maximum_t02_b_anchor_relative_current_difference": 1e-6,
    "maximum_t02_b_anchor_potential_difference_v": 1e-7,
    "required_t02_b_anchor_vtg_values_v": [0.0, 0.1, 0.2, 0.3],
    "require_positive_drain_and_negative_source_current": true,
    "require_strict_primary_gate_current_increase": true,
    "require_strict_secondary_gate_current_ordering": true,
    "require_vth_bracket_for_every_forward_family": true,
    "require_delta_vth_strictly_decreases_with_secondary_bias": true,
