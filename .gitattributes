* text=auto

*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.cir text eol=lf
*.inc text eol=lf
*.xhtml text eol=lf
Makefile text eol=lf

# Raw tool logs are hash-bound evidence and must remain byte-for-byte intact.
results/compact/**/*.log text eol=lf -whitespace
# Generated parser/scanner and fixed-column Xyce output are also hash-bound evidence.
results/compact/m01_xyce_build_preflight_r07/*.c text eol=lf -whitespace
results/compact/m01_xyce_build_preflight_r07/*.prn text eol=lf -whitespace
results/compact/m01_xyce_build_preflight_r10/*.prn text eol=lf -whitespace
results/compact/m01_xyce_build_preflight_r11/*.prn text eol=lf -whitespace

# R02 formal device-DC artifacts are SHA-bound in the runner report.
results/compact/m01_open_source_cross_check_r02/** -text -whitespace
results/tables/m01_ngspice_open_source_r02_raw.csv -text -whitespace
results/tables/m01_xyce_open_source_r02_raw.csv -text -whitespace
results/tables/m01_open_source_route_metrics_r02.csv -text -whitespace
results/tables/m01_open_source_route_difference_r02.csv -text -whitespace

# R03 formal device-DC artifacts are SHA-bound in the runner report.
results/compact/m01_open_source_cross_check_r03/** -text -whitespace
results/tables/m01_ngspice_open_source_r03_raw.csv -text -whitespace
results/tables/m01_xyce_open_source_r03_raw.csv -text -whitespace
results/tables/m01_open_source_route_metrics_r03.csv -text -whitespace
results/tables/m01_open_source_route_difference_r03.csv -text -whitespace

# R02 root-cause probe artifacts are SHA-bound and must remain byte-for-byte intact.
results/compact/m01_route_divergence_root_cause_r02/** -text -whitespace
results/tables/m01_route_divergence_root_cause_r02.csv -text -whitespace

# C00 R03 failed-run native artifacts are SHA-bound and remain byte-for-byte intact.
results/compact/c00_active_load_inverter_r03/** -text -whitespace

*.png binary
*.jpg binary
*.jpeg binary
